# LAMMPS input file for NPGrowth V2 "sintering" mode (geometry-enabled, no substrate)
# The generated deposition fragment (4source_tetra_zerovel.in) is included below.
# Geometry mode places N seed clusters at rest (vx 0 0) -> sintering-start config.
# Expects a Cu_u3.eam potential and monoatomic (Cu147-like) cluster seeds.

### Initialize #################################

units metal                              # metal units: distance Angstrom, time ps, energy eV, temperature K
atom_style atomic                        # atoms described by ID, type, position, velocity, etc.
boundary f f f                           # fixed/non-periodic boundaries in x, y, z


### System definition ##########################

region simulation_box block -10 70 -10 70 -10 70
                                        # box sized to contain the generated source/target regions
                                        # (tetra vertices ~19..49 A) plus the cluster radius

create_box 2 simulation_box             # 2 types: base type 1 ("Cu") + type 2 used by the
                                        # deposited molecule atoms (base 1 + internal mol type 1 = 2)

labelmap atom 1 Cu                      # assign "Cu" to atom type 1
                                        # (type 2 is the same element -> no separate label,
                                        #  dump element mapping below covers both)
mass 1 63.546
mass 2 63.546


### Settings ###################################

pair_style eam                          # embedded atom method potential
pair_coeff * * /Users/gilberto/Desktop/scienza/code/NPGrowth_V2/lammps_run/potentials/Cu_u3.eam
                                        # Cu EAM potential applied to all types (1 and 2)


### Visualize ###################################

thermo 500
thermo_style custom step temp pe ke etotal press

dump dump1 all custom 500 ./sintering_tetra.traj id type element x y z vx vy vz
dump_modify dump1 element Cu Cu        # element "Cu" for both type 1 and type 2


### Run (sintering) ############################

timestep 0.0025                          # integration timestep = 0.0025 ps = 2.5 fs

group added empty                       # group referenced by the deposit fixes below

fix my_nve all nve                      # integrate the equations of motion (NVE)

fix lgv_initial all langevin 300.0 300.0 0.1 42
                                        # Langevin thermostat on ALL atoms (no substrate here):
                                        # temperature = 300 K, damping = 0.1 ps, seed = 42

include /Users/gilberto/Desktop/scienza/code/NPGrowth_V2/deposition_generator/generated_inputs/4source_tetra_zerovel.in
                                        # geometry-generated deposition: places the 4 clusters at rest
                                        # at the first timestep (n_depo 1, every 1, vx 0 0)

run 400000                              # evolve: separated clusters, all thermostatted -> sinter
