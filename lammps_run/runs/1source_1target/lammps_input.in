# LAMMPS input file generated by NPGrowth
# This file is intended to be modified by the user.
# For example, the pair_coeff and mass commands may need to be updated
# when using different atomic elements.
# This basic example expects a Cu EAM potential file inside the potentials folder.

### Initialize #################################

units metal                              # Use metal units: distance = Angstrom, time = ps, energy = eV, temperature = K
atom_style atomic                        # Atoms are described by ID, type, position, velocity, etc.
boundary f f f                           # Fixed/non-periodic boundaries in x, y, and z directions


### System definition ##########################

region simulation_box block -400 400 -400 400 -400 400
                                        # Define a simulation box from -400 to 400 Angstrom in x, y, and z

create_box 1 simulation_box             # Create a simulation box containing 1 atom type

labelmap atom 1 Cu                      # Assign the chemical label "Cu" to atom type 1

read_dump /Users/gilberto/Desktop/scienza/code/NPGrowth_V2/lammps_run/seeds/Cu1688_Cube_com.xyz 0 x y z box no add yes format xyz
                                        # Read atomic coordinates from an XYZ file:
                                        # timestep = 0, columns = x y z,
                                        # do not overwrite the simulation box,
                                        # add atoms to the current system


### Logic for atom groups #######################

group added empty                       # Create an initially empty group for newly added/deposited atoms

group initial subtract all added        # Define the initial group as all atoms excluding the "added" group

compute coordination added coord/atom cutoff 4.9 group initial
                                        # Compute, for each atom in "added", the number of neighbors
                                        # belonging to "initial" within a cutoff distance of 4.9 Angstrom

variable attached atom "c_coordination > 2"
                                        # Define an atom-style variable:
                                        # an atom is considered attached if its coordination number is greater than 2

group attached dynamic added var attached every 2
                                        # Dynamically update the "attached" group from atoms in "added"
                                        # according to the variable "attached", every 2 timesteps


### Settings ###################################

pair_style eam                          # Use the Embedded Atom Method (EAM) potential for atomic interactions

pair_coeff * * /Users/gilberto/Desktop/scienza/code/NPGrowth_V2/lammps_run/potentials/Cu_u3.eam
                                        # Apply the Cu EAM potential file to all atom types

fix momentum_fix initial momentum 1 linear 1 1 1 angular rescale
                                        # Remove linear and angular momentum from the "initial" group every timestep
                                        # Linear momentum is removed in x, y, and z; velocities are rescaled afterward


### Visualize ###################################

thermo 500                              # Print thermodynamic information every 5000 timesteps

thermo_style custom step temp pe ke etotal press
                                        # Output: timestep, temperature, potential energy, kinetic energy,
                                        # total energy, and pressure

dump dump1 all custom 500 ./1source_1target.traj id type element x y z vx vy vz v_attached
                                        # Write atomic trajectory data every 5000 timesteps:
                                        # atom ID, type, element, position, velocity, and attachment flag

dump_modify dump1 element Cu            # Assign the element name Cu to atom type 1 in the trajectory output


### Run #########################################

timestep 0.002                          # Set the integration timestep to 0.002 ps = 2 fs

fix my_nve all nve                      # Integrate the equations of motion using the NVE ensemble

fix lgv_initial initial langevin 100.0 100.0 0.1 42
                                        # Apply a Langevin thermostat to the "initial" group:
                                        # target temperature = 100 K,
                                        # final temperature = 100 K,
                                        # damping parameter = 0.1 ps,
                                        # random number seed = 42

include /Users/gilberto/Desktop/scienza/code/NPGrowth_V2/deposition_generator/generated_inputs/1source_1targets.in
                                        # Include an external LAMMPS input file containing deposition instructions

run 13000000 every 50 "group attached static" "group initial union attached initial" "group added subtract added attached" "group attached dynamic added var attached every 2"
                                        # Run the simulation for 13,000,000 timesteps
                                        # Every 5000 timesteps:
                                        # 1. Convert the current "attached" group to a static group
                                        # 2. Add attached atoms to the "initial" group
                                        # 3. Remove attached atoms from the "added" group
                                        # 4. Recreate the dynamic "attached" group from the remaining added atoms
